# =============================================
# SIH26143 — Local Development Environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================

# =============================================
# MongoDB  —  ONLINE (recommended, no local mongod)
# =============================================
# Get this string from MongoDB Atlas:
#   Atlas > Database > your cluster > Connect > Drivers
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Create a database user (NOT the org/project admin) and allow your dev IPs.
# With this set, the launchers (start-stack.ps1 / start-stack-visible.ps1) do
# NOT start a local MongoDB.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=oilspill

# Fallback (optional): local MongoDB on :27017, e.g.:
# MONGODB_URI=mongodb://localhost:27017

# --- MongoDB AI / model key (NOT storage) ---
# ai.mongodb.com is MongoDB's Embeddings & Reranking (Voyage AI) API. A key
# created in Atlas under "Model API Keys" (format al-...) is a Bearer token for
# /v1/embeddings & /v1/rerank ONLY — it does NOT connect the app to storage.
# Storage is configured solely via MONGODB_URI above. If you later add an
# embeddings feature, set the model key here (never commit the real value):
# MONGODB_AI_MODEL_KEY=

# --- Spring Boot backend ---
# NOTE: 8080 is reserved by an unrelated local app (Vtkro). Backend uses 8082.
SPRING_PORT=8082
PYTHON_SERVICE_URL=http://localhost:8000

# --- Scientific service (FastAPI) ---
FASTAPI_PORT=8000

# --- Frontend ---
VITE_API_URL=http://localhost:8082
VITE_WS_URL=ws://localhost:8082

# --- Copernicus Marine (CMEMS) ---
# Register at https://data.marine.copernicus.eu to obtain credentials
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- ERA5 (CDS API) ---
# Register at https://cds.climate.copernicus.eu to obtain an API key
# Format: <uid>:<api-key>
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=