# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://yogeshwar19ys432264_db_user:iTan8XqMQcoPyIN4@cluster0.lbunryr.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=oilspill

# --- Scientific service (FastAPI) ---
FASTAPI_PORT=8000

# --- Frontend ---
VITE_API_URL=http://localhost:8082
VITE_WS_URL=ws://localhost:8082

# --- Copernicus Marine (CMEMS) ---
# Register at https://data.marine.copernicus.eu to obtain credentials
